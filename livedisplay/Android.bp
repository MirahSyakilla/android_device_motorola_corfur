cc_defaults {
    name: "livedisplay_corfur",
    defaults: ["hidl_defaults"],
    relative_install_path: "hw",
    srcs: [
        ":vendor.lineage.livedisplay-sdm-pa",
        ":vendor.lineage.livedisplay-sdm-utils",
        "AntiFlicker.cpp",
        "SunlightEnhancement.cpp",
        "service.cpp",
    ],
    shared_libs: [
        "libbase",
        "libbinder",
        "libcutils",
        "libdl",
        "libhidlbase",
        "libutils",
        "vendor.lineage.livedisplay",
    ],
    header_libs: [
        "vendor.lineage.livedisplay-sdm-headers",
    ],
}

cc_binary {
    name: "vendor.lineage.livedisplay-service.corfur",
    init_rc: ["vendor.lineage.livedisplay-service.corfur.rc"],
    defaults: ["livedisplay_corfur"],
    vendor: true,
}
